{
  "name": "evenly",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first bill splitting with receipt scanning and exact-to-the-cent splits.",
  "author": "Emir Konur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emirk35/evenly.git"
  },
  "main": "expo-router/entry",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start --port 4510",
    "web": "expo start --web --port 4511",
    "ios": "expo run:ios --port 4510",
    "android": "expo run:android --port 4510",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "export:web": "expo export --platform web",
    "typegen": "expo customize tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-text-extractor": "^2.0.0",
    "lucide-react-native": "1.67.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "3.0.0",
    "babel-preset-expo": "~58.0.23",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "3.9.10",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  }
}
